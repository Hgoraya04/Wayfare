# Copy to .env and fill in. Never commit .env.
# Neon gives you this connection string on the project dashboard.
# The ?sslmode=require suffix is required by Neon.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/wayfare?sslmode=require

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Cloud console -> Places API (New). Billing must be enabled even for the free tier.
GOOGLE_PLACES_API_KEY=

# https://app.duffel.com -> Developers -> Access tokens. Use the TEST token (duffel_test_...).
DUFFEL_API_TOKEN=

PORT=4000
